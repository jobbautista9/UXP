# -*- Mode: python; indent-tabs-mode: nil; tab-width: 4 -*-
# vim: set filetype=python:
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at http://mozilla.org/MPL/2.0/.

# ASM enabled

ASFLAGS += [
    '-I%s/media/libdav1d/upstream/src/' % TOPSRCDIR,
    '-DHAVE_AVX512ICL=1',
]

LOCAL_INCLUDES += [
    '/media/libdav1d/upstream/',
    '/media/libdav1d/upstream/include/',
    '/media/libdav1d/upstream/src/',
]

# Don't export DAV1D_API symbols from libxul
# see: media/libdav1d/upstream/include/dav1d/common.h
DEFINES['DAV1D_API'] = ''

CFLAGS += [
    # find the config.h file.
    '-I%s/dist/include/dav1d/' % TOPOBJDIR,
]

# Store the stack alignment that will be used.
stack_alignment = 0

# Attaching config.asm file
if CONFIG['CPU_ARCH'] == 'x86':
    # Default stack alignment can be 4 bytes.
    if CONFIG['OS_TARGET'] == 'WINNT':
        stack_alignment = 4
        ASFLAGS += ['-I%s/media/libdav1d/asm/x86_32/win/' % TOPSRCDIR]
    else:
        ASFLAGS += ['-I%s/media/libdav1d/asm/x86_32/' % TOPSRCDIR]
        stack_alignment = 16
        # Change stack alignment to 16 bytes.
        if CONFIG['CC_TYPE'] == 'clang':
            CFLAGS += ['-mstack-alignment=16']
        elif CONFIG['CC_TYPE'] == 'gcc':
            CFLAGS += ['-mpreferred-stack-boundary=4']
elif CONFIG['CPU_ARCH'] == 'x86_64':
    # Default stack aligment is 16 bytes.
    stack_alignment = 16
    if CONFIG['OS_TARGET'] == 'Darwin':
        ASFLAGS += ['-I%s/media/libdav1d/asm/x86_64/osx/' % TOPSRCDIR]
    elif CONFIG['OS_TARGET'] == 'WINNT':
        ASFLAGS += ['-I%s/media/libdav1d/asm/x86_64/win/' % TOPSRCDIR]
    else:
        # The rest of the platforms are all Linux-like: plain Linux
        # Android, OpenBSD, NetBSD, FreeBSD, DragonFly, SunOS
        ASFLAGS += ['-I%s/media/libdav1d/asm/x86_64/linux/' % TOPSRCDIR]
elif CONFIG['CPU_ARCH'] == 'aarch64':
    stack_alignment = 16
    ASFLAGS += ['-I%s/dist/include/dav1d/' % TOPOBJDIR]
else:
    error('Cpu arch %s is not expected' % CONFIG['CPU_ARCH'])

# Set the macro here instead of config.h
if stack_alignment == 0:
    error('Stack alignment cannot be zero.')
DEFINES['STACK_ALIGNMENT'] = stack_alignment

if CONFIG['CPU_ARCH'] in ('x86', 'x86_64'):
    ASFLAGS += ['-Dprivate_prefix=dav1d']

    SOURCES += [
        '/media/libdav1d/upstream/src/x86/cpu.c',
        '/media/libdav1d/upstream/src/x86/msac_init.c',
        '/media/libdav1d/upstream/src/x86/refmvs_init.c',
    ]

    EXPORTS.dav1d += [
        '/media/libdav1d/upstream/src/x86/cpu.h',
        '/media/libdav1d/upstream/src/x86/msac.h',
    ]

    # ASM source files
    if CONFIG['CPU_ARCH'] == 'x86_64':
        # Empty file on all other archs. Nasm produces
        # an error when it compiles empty files.
        SOURCES += [
            '/media/libdav1d/upstream/src/x86/cdef16_avx2.asm', # moved from autovendored
            '/media/libdav1d/upstream/src/x86/cdef_avx2.asm',
            '/media/libdav1d/upstream/src/x86/cdef_avx512.asm',
            '/media/libdav1d/upstream/src/x86/filmgrain16_avx2.asm',
            '/media/libdav1d/upstream/src/x86/filmgrain16_avx512.asm',
            '/media/libdav1d/upstream/src/x86/filmgrain_avx2.asm',
            '/media/libdav1d/upstream/src/x86/filmgrain_avx512.asm',
            # '/media/libdav1d/upstream/src/x86/filmgrain_common.asm',
            # ^ filmgrain_common.asm must *not* be in SOURCES because it's only
            # used as an %include for other .asm files. Trying to assemble it
            # will result in a nasm error: parser: instruction expected
            '/media/libdav1d/upstream/src/x86/ipred16_avx512.asm',
            '/media/libdav1d/upstream/src/x86/ipred_avx2.asm',
            '/media/libdav1d/upstream/src/x86/ipred_avx512.asm',
            '/media/libdav1d/upstream/src/x86/itx16_avx2.asm',
            '/media/libdav1d/upstream/src/x86/itx_avx2.asm',
            '/media/libdav1d/upstream/src/x86/itx_avx512.asm',
            '/media/libdav1d/upstream/src/x86/loopfilter16_avx2.asm',
            '/media/libdav1d/upstream/src/x86/loopfilter_avx2.asm',
            '/media/libdav1d/upstream/src/x86/loopfilter_avx512.asm',
            '/media/libdav1d/upstream/src/x86/looprestoration16_avx2.asm',
            '/media/libdav1d/upstream/src/x86/looprestoration16_avx512.asm',
            '/media/libdav1d/upstream/src/x86/looprestoration_avx2.asm',
            '/media/libdav1d/upstream/src/x86/looprestoration_avx512.asm',
            '/media/libdav1d/upstream/src/x86/mc16_avx2.asm',
            '/media/libdav1d/upstream/src/x86/mc16_avx512.asm',
            '/media/libdav1d/upstream/src/x86/mc_avx2.asm',
            '/media/libdav1d/upstream/src/x86/mc_avx512.asm',
        ]

    SOURCES += [
        '/media/libdav1d/upstream/src/x86/cdef16_sse.asm',
        '/media/libdav1d/upstream/src/x86/cdef_sse.asm',
        '/media/libdav1d/upstream/src/x86/cpuid.asm',
        '/media/libdav1d/upstream/src/x86/filmgrain16_sse.asm',
        '/media/libdav1d/upstream/src/x86/filmgrain_sse.asm',
        '/media/libdav1d/upstream/src/x86/ipred16_avx2.asm',
        '/media/libdav1d/upstream/src/x86/ipred16_sse.asm',
        '/media/libdav1d/upstream/src/x86/ipred_sse.asm',
        '/media/libdav1d/upstream/src/x86/itx16_sse.asm',
        '/media/libdav1d/upstream/src/x86/itx_sse.asm',
        '/media/libdav1d/upstream/src/x86/loopfilter16_sse.asm',
        '/media/libdav1d/upstream/src/x86/loopfilter_sse.asm',
        '/media/libdav1d/upstream/src/x86/looprestoration16_sse.asm', # moved from autovendored
        '/media/libdav1d/upstream/src/x86/looprestoration_sse.asm',
        '/media/libdav1d/upstream/src/x86/mc16_sse.asm',
        '/media/libdav1d/upstream/src/x86/mc_sse.asm',
        '/media/libdav1d/upstream/src/x86/msac.asm',
        '/media/libdav1d/upstream/src/x86/refmvs.asm',
    ]

    # BITDEPTH
    # All the files here are generated by update.sh.
    # Do not use the *_tmpl.c files from the upstream subdirectory
    # directly, because they don't have BITDEPTH defined.
    SOURCES += [
        '/media/libdav1d/tmpl/x86/16bd_cdef_init_tmpl.c',
        '/media/libdav1d/tmpl/x86/16bd_filmgrain_init_tmpl.c',
        '/media/libdav1d/tmpl/x86/16bd_ipred_init_tmpl.c',
        '/media/libdav1d/tmpl/x86/16bd_itx_init_tmpl.c',
        '/media/libdav1d/tmpl/x86/16bd_loopfilter_init_tmpl.c',
        '/media/libdav1d/tmpl/x86/16bd_looprestoration_init_tmpl.c',
        '/media/libdav1d/tmpl/x86/16bd_mc_init_tmpl.c',
    ]

    SOURCES += [
        '/media/libdav1d/tmpl/x86/8bd_cdef_init_tmpl.c',
        '/media/libdav1d/tmpl/x86/8bd_filmgrain_init_tmpl.c',
        '/media/libdav1d/tmpl/x86/8bd_ipred_init_tmpl.c',
        '/media/libdav1d/tmpl/x86/8bd_itx_init_tmpl.c',
        '/media/libdav1d/tmpl/x86/8bd_loopfilter_init_tmpl.c',
        '/media/libdav1d/tmpl/x86/8bd_looprestoration_init_tmpl.c',
        '/media/libdav1d/tmpl/x86/8bd_mc_init_tmpl.c',
    ]

elif CONFIG['CPU_ARCH'] == 'arm' or CONFIG['CPU_ARCH'] == 'aarch64':
    SOURCES += [
        '/media/libdav1d/upstream/src/arm/cpu.c',
        '/media/libdav1d/upstream/src/arm/refmvs_init.c',
    ]
    EXPORTS += [
        '/media/libdav1d/upstream/src/arm/asm-offsets.h',
        '/media/libdav1d/upstream/src/arm/cpu.h',
        '/media/libdav1d/upstream/src/arm/msac.h',
    ]

    # BITDEPTH
    # All the files here are generated by update.sh.
    # Do not use the *_tmpl.c files from the upstream subdirectory
    # directly, because they don't have BITDEPTH defined.
    SOURCES += [
        '/media/libdav1d/tmpl/arm/16bd_cdef_init_tmpl.c',
        '/media/libdav1d/tmpl/arm/16bd_filmgrain_init_tmpl.c',
        '/media/libdav1d/tmpl/arm/16bd_ipred_init_tmpl.c',
        '/media/libdav1d/tmpl/arm/16bd_itx_init_tmpl.c',
        '/media/libdav1d/tmpl/arm/16bd_loopfilter_init_tmpl.c',
        '/media/libdav1d/tmpl/arm/16bd_looprestoration_init_tmpl.c',
        '/media/libdav1d/tmpl/arm/16bd_mc_init_tmpl.c',
    ]

    SOURCES += [
        '/media/libdav1d/tmpl/arm/8bd_cdef_init_tmpl.c',
        '/media/libdav1d/tmpl/arm/8bd_filmgrain_init_tmpl.c',
        '/media/libdav1d/tmpl/arm/8bd_ipred_init_tmpl.c',
        '/media/libdav1d/tmpl/arm/8bd_itx_init_tmpl.c',
        '/media/libdav1d/tmpl/arm/8bd_loopfilter_init_tmpl.c',
        '/media/libdav1d/tmpl/arm/8bd_looprestoration_init_tmpl.c',
        '/media/libdav1d/tmpl/arm/8bd_mc_init_tmpl.c',
    ]

    # BITDEPTH .S files
    if CONFIG['CPU_ARCH'] == 'aarch64':
        SOURCES += [
            '/media/libdav1d/upstream/src/arm/64/cdef.S',
            '/media/libdav1d/upstream/src/arm/64/cdef16.S',
            '/media/libdav1d/upstream/src/arm/64/cdef_tmpl.S',
            '/media/libdav1d/upstream/src/arm/64/filmgrain.S',
            '/media/libdav1d/upstream/src/arm/64/filmgrain16.S',
            '/media/libdav1d/upstream/src/arm/64/ipred.S',
            '/media/libdav1d/upstream/src/arm/64/ipred16.S',
            # itx.S is used for both 8 and 16 bpc.
            '/media/libdav1d/upstream/src/arm/64/itx.S',
            '/media/libdav1d/upstream/src/arm/64/itx16.S',
            '/media/libdav1d/upstream/src/arm/64/loopfilter.S',
            '/media/libdav1d/upstream/src/arm/64/loopfilter16.S',
            '/media/libdav1d/upstream/src/arm/64/looprestoration.S',
            '/media/libdav1d/upstream/src/arm/64/looprestoration16.S',
            '/media/libdav1d/upstream/src/arm/64/looprestoration_common.S',
            '/media/libdav1d/upstream/src/arm/64/looprestoration_tmpl.S',
            '/media/libdav1d/upstream/src/arm/64/mc.S',
            '/media/libdav1d/upstream/src/arm/64/mc16.S',
            '/media/libdav1d/upstream/src/arm/64/msac.S',
            '/media/libdav1d/upstream/src/arm/64/refmvs.S',
        ]
    elif CONFIG['CPU_ARCH'] == 'arm':
        SOURCES += [
            '/media/libdav1d/upstream/src/arm/32/cdef.S',
            '/media/libdav1d/upstream/src/arm/32/cdef16.S',
            '/media/libdav1d/upstream/src/arm/32/cdef_tmpl.S',
            '/media/libdav1d/upstream/src/arm/32/filmgrain.S',
            '/media/libdav1d/upstream/src/arm/32/filmgrain16.S',
            '/media/libdav1d/upstream/src/arm/32/ipred.S',
            '/media/libdav1d/upstream/src/arm/32/ipred16.S',
            '/media/libdav1d/upstream/src/arm/32/itx.S',
            '/media/libdav1d/upstream/src/arm/32/itx16.S',
            '/media/libdav1d/upstream/src/arm/32/loopfilter.S',
            '/media/libdav1d/upstream/src/arm/32/loopfilter16.S',
            '/media/libdav1d/upstream/src/arm/32/looprestoration.S',
            '/media/libdav1d/upstream/src/arm/32/looprestoration16.S',
            '/media/libdav1d/upstream/src/arm/32/looprestoration_common.S',
            '/media/libdav1d/upstream/src/arm/32/looprestoration_tmpl.S',
            '/media/libdav1d/upstream/src/arm/32/mc.S',
            '/media/libdav1d/upstream/src/arm/32/mc16.S',
            '/media/libdav1d/upstream/src/arm/32/msac.S',
            '/media/libdav1d/upstream/src/arm/32/refmvs.S',
        ]

if CONFIG['CPU_ARCH'] in ('x86', 'x86_64'):
    USE_NASM = True
elif CONFIG['CPU_ARCH'] == 'aarch64' and CONFIG['OS_TARGET'] == 'WINNT':
    USE_INTEGRATED_CLANGCL_AS = True

FINAL_LIBRARY = 'gkmedias'

# We allow warnings for third-party code that can be updated from upstream.
ALLOW_COMPILER_WARNINGS = True
